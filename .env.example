# =============================================================================
# NEXUS OSINT Platform — Environment Variables
# =============================================================================

# --- Database ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus_secret_2025

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_pg_secret

REDIS_URL=redis://localhost:6379/0

ELASTICSEARCH_URL=http://localhost:9200

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nexus_minio
MINIO_SECRET_KEY=nexus_minio_secret

# --- Authentication ---
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- CYBINT API Keys ---
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_API_KEY=
SECURITYTRAILS_API_KEY=

# --- SOCMINT API Keys ---
TWITTER_BEARER_TOKEN=
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- SIGINT API Keys ---
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
AIS_API_KEY=
AIS_API_URL=https://api.aisstream.io

# --- GEOINT ---
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
NOMINATIM_USER_AGENT=NEXUS-OSINT/0.1
GEOIP_DB_PATH=

# --- LLM ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
