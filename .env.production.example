# =============================================================================
# NEXUS OSINT Platform — Production Environment Configuration
# =============================================================================
# Copy this file to .env and set all required values before starting.
# WARNING: Never commit .env files with real secrets to version control.
# =============================================================================

NEXUS_ENV=production

# --- JWT (REQUIRED — must be changed) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# REQUIRED — change from default
NEO4J_PASSWORD=

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
# REQUIRED — change from default
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (restrict to your domain) ---
CORS_ORIGINS=https://your-domain.com

# --- Security ---
AUDIT_LOG_ENABLED=true
PASSWORD_MIN_LENGTH=12

# --- CYBINT API Keys ---
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_API_KEY=
SECURITYTRAILS_API_KEY=

# --- SOCMINT ---
TWITTER_BEARER_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- SIGINT ---
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
AIS_API_KEY=

# --- GEOINT ---
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
NOMINATIM_USER_AGENT=NEXUS-OSINT/0.2
GEOIP_DB_PATH=

# --- LLM ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# --- MinIO ---
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
